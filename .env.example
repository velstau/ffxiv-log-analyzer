APP_NAME="FFLogs Timeline Viewer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8070

# FFLogs API (v2 client credentials)
# 利用者が画面（/api-key）で自分のキーを設定する。キーは利用者のブラウザの Cookie に暗号化して置き、サーバーには保存しない。
# 公開環境では下の 3 つは空・false のままにする（運営者のキーを他人に使わせない）。
# 開発で .env のキーを使いたいときだけ、ALLOW を true にしてキーを書く（値は絶対にコミットしないこと）。
FFLOGS_ALLOW_SERVER_CREDENTIALS=false
FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=
# 参照するリージョン。既定は日本語版 (ja.fflogs.com)。
FFLOGS_TOKEN_URL=https://ja.fflogs.com/oauth/token
FFLOGS_API_URL=https://ja.fflogs.com/api/v2/client

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
